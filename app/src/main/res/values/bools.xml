<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <!--
        Whether the system navigation bar sits on a light background, which is what
        android:windowLightNavigationBar states: true makes Android draw DARK icons on it.
        Light mode puts the bar on the white surface, so it is true here and false in
        values-night.

        This is a resource rather than a literal in the theme so that a single navigation
        bar declaration on Base.AdAway resolves correctly in both modes. Base.AdAway must
        not be redeclared in values-night: a night-qualified style replaces the light one
        wholesale instead of merging with it, so every other item it carries would be
        silently dropped in dark mode.
    -->
    <bool name="navigationBarIsLight">true</bool>
</resources>

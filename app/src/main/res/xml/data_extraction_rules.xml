<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above read this instead of the older backup attributes. Everything is
    excluded from both channels: cloud-backup would send preferences and user rules to Google
    Drive, and device-transfer would hand them to a new phone during setup. Neither happens.
    Preferences > Backup and restore still exports and restores them to a file on request.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>

    <string name="vpn_persistence_title">استمرارية VPN</string>
    <string name="vpn_persistence_message">يتعامل AdAway بالفعل مع عمليات إعادة التشغيل، وحالات الإنهاء بسبب نقص الذاكرة، والأعطال من تلقاء نفسه، لذا لا حاجة إلى أي إعداد إضافي في معظم الحالات.\n\nإذا توقّف VPN بشكل غير متوقع في أي وقت، فثبّت AdAway باعتباره VPN الدائم في نظام Android للحصول على أقوى ضمان.</string>
    <string name="vpn_persistence_status_enabled">‏VPN الدائم مُفعّل لـ AdAway. ✓</string>
    <string name="vpn_persistence_status_disabled">‏VPN الدائم غير مضبوط. تتولى استمرارية AdAway المدمجة ذلك.</string>
    <string name="tv_persistence_adb_commands">إذا كانت شاشة VPN الخاصة بالنظام مخفية على تلفازك، فاستخدم ADB:\n\n• تفعيل الدائم لـ AdAway:\n  adb shell settings put global always_on_vpn_app %1$s\n\n• تعطيل الدائم:\n  adb shell settings delete global always_on_vpn_app</string>
    <string name="vpn_persistence_open_settings">فتح إعدادات VPN</string>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!--
        Header split into two rows (title, actions), the same reasoning as tv_activity_log.xml:
        cramming everything into one row risks a long translation (this app ships 60+ locales)
        wrapping or pushing a neighbour off-screen, and there is no way to preview every locale
        here to catch it.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!--
            Row 1: the title IS the current tab (Blocked/Allowed/Redirected), icon and label
            updated in code. Plain label, not a button: switching tabs goes back out to the TV
            home screen's Blocked/Allowed/Redirected tiles, not through a picker on this screen,
            so this row has nothing to do when clicked and is not focusable.
        -->
        <LinearLayout
            android:id="@+id/tv_lists_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/tv_lists_title_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                tools:src="@drawable/baseline_block_24"
                android:contentDescription="@string/lists_title"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tv_lists_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/lists_tab_blocked"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="?attr/colorOnPrimary" />
        </LinearLayout>

        <!-- Row 2: actions. A plain button here, not a FAB: a FAB is a touch-first pattern
             (float over content, reach with a thumb) that has no natural D-pad neighbour,
             which is exactly the shape of bug the previous two commits had to patch around
             on the phone layout. A button that lives in the header has one from the start.
             layout_gravity centres this row (still wrap_content, so the buttons stay next to
             each other) within the header instead of leaving it flush against the icon/title
             above it, which read as unfinished on a screen this wide. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_lists_add"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_add"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnPrimary"
                android:focusable="true"
                android:layout_marginEnd="8dp"
                android:nextFocusRight="@id/tv_lists_search"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_add_black_24px"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnPrimary"
                app:strokeColor="?attr/colorOnPrimary"
                app:rippleColor="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_lists_search"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_dialog_search"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnPrimary"
                android:focusable="true"
                android:layout_marginEnd="8dp"
                android:nextFocusLeft="@id/tv_lists_add"
                android:nextFocusRight="@id/tv_lists_toggle_sources"
                app:cornerRadius="20dp"
                app:icon="@drawable/baseline_search_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnPrimary"
                app:strokeColor="?attr/colorOnPrimary"
                app:rippleColor="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_lists_toggle_sources"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lists_menu_toggle_sources"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnPrimary"
                android:focusable="true"
                android:nextFocusLeft="@id/tv_lists_search"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_collections_bookmark_24dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnPrimary"
                app:strokeColor="?attr/colorOnPrimary"
                app:rippleColor="?attr/colorOnPrimary" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tv_lists_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_lists_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="48dp"
            android:text="@string/tv_lists_empty"
            android:textAppearance="?attr/textAppearanceBody1"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget layout for SwitchPreferenceCompat, swapping the default SwitchCompat for a
    Material 3 MaterialSwitch (same approach as Material Files).
    @see androidx.preference:preference:layout/preference_widget_switch_compat

    The MaterialSwitch is hosted in an isolated Material 3 theme overlay so it gets the
    MD3 colour tokens it needs even though the app theme is Material 2. No tint or
    drawable overrides: the look is the stock MD3 switch tinted with colorPrimary.
-->
<com.google.android.material.materialswitch.MaterialSwitch
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/switchWidget"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null"
    android:clickable="false"
    android:focusable="false"
    android:theme="@style/ThemeOverlay.AdAway.MaterialSwitch" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    MaterialCardView is the row root (== the ViewHolder's itemView in TvHostsSourcesAdapter), same
    outlined, no-elevation TV card style already shipped on the Home screen's tiles
    (Widget.AdAway.TvHomeCard in styles.xml) rather than a flat, undifferentiated row: three
    consecutive sources with no border between them were hard to tell apart at a glance. The style
    already carries clickable/focusable, so the row keeps reacting to D-pad focus and click exactly
    as before; itemView.setAlpha() in the adapter now dims the whole card, border included, for a
    disabled source.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.AdAway.TvHomeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_source_item_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="StevenBlack Unified hosts" />

        <TextView
            android:id="@+id/tv_source_item_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_source_item_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceSubtitle2"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Up-to-date for 12 hours" />

            <TextView
                android:id="@+id/tv_source_item_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle2"
                tools:text="99k hosts" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/tv_source_item_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="StevenBlack Unified hosts" />

    <TextView
        android:id="@+id/tv_source_item_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceCaption"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_source_item_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Up-to-date for 12 hours" />

        <TextView
            android:id="@+id/tv_source_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceSubtitle2"
            tools:text="99k hosts" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Own layout rather than the phone's source_edit_activity.xml, for the same reason Lists and
    Hosts sources got their own: Save/Delete live in the ActionBar's overflow there, reachable
    only by steering D-pad focus up into the toolbar, and the ConstraintLayout body has no
    guaranteed top-to-bottom focus order since fields are positioned by constraint/bias rather
    than by simple stacking. Here Save/Delete are plain header buttons (the same shape every
    other TV screen in this app already uses) and the form is one linear column, so default
    D-pad search has an unambiguous path through it.

    Reuses the same TextInputLayout/MaterialButtonToggleGroup/MaterialCheckBox fields as the
    phone screen (real, individually focusable widgets that were never the problem) and every
    existing source_edit_* / checkbox_list_context_* string, so nothing new needed translating.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/baseline_edit_24"
                android:contentDescription="@string/source_edit_title"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tv_source_edit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:textColor="?attr/colorOnPrimary"
                tools:text="@string/source_edit_add_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_source_edit_apply"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/checkbox_list_context_apply"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnPrimary"
                android:focusable="true"
                android:focusedByDefault="true"
                app:cornerRadius="20dp"
                app:icon="@drawable/baseline_check_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnPrimary"
                app:strokeColor="?attr/colorOnPrimary"
                app:rippleColor="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_source_edit_delete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checkbox_list_context_delete"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:textColor="?attr/colorOnPrimary"
                android:focusable="true"
                android:visibility="gone"
                app:cornerRadius="20dp"
                app:icon="@drawable/outline_delete_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="?attr/colorOnPrimary"
                app:strokeColor="?attr/colorOnPrimary"
                app:rippleColor="?attr/colorOnPrimary"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tv_source_label_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/source_edit_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tv_source_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/source_edit_format"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tv_source_format_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:checkedButton="@+id/tv_source_block_button"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_source_block_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_edit_format_block_list" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_source_allow_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_edit_format_allow_list" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/source_edit_type"
                android:textAppearance="?attr/textAppearanceCaption" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tv_source_type_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:checkedButton="@+id/tv_source_url_button"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_source_url_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_edit_url" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_source_file_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_edit_file" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tv_source_url_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/source_edit_url_location">

                <org.adaway.ui.source.EndCursorEditText
                    android:id="@+id/tv_source_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/source_edit_url_location_default" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_source_file_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:text="@string/source_edit_file_hint"
                android:textAppearance="?attr/textAppearanceBody2"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/tv_source_redirected_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/source_edit_redirected_hosts" />

            <TextView
                android:id="@+id/tv_source_redirected_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:justificationMode="inter_word"
                android:text="@string/source_edit_redirected_hosts_warning"
                android:textAppearance="?attr/textAppearanceCaption" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

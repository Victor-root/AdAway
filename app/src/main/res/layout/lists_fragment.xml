<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Bottom navigation footer. The BottomNavigationView is wrapped in a container so a thick
        white indicator (nav_indicator) can be overlaid on the BOTTOM edge of the active tab,
        moved in code as the selection changes (like a TabLayout indicator). Sitting on the
        bottom edge, between the red footer and the system navigation bar (also red, see
        Theme.AdAway.Lists), makes it clearly visible against solid red on both sides; the top edge
        sits right at the seam with the white content above, where it barely showed. Elevation is
        0: the footer is flat, with no drop shadow above it.
    -->
    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:elevation="0dp"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemRippleColor="#33FFFFFF"
            app:itemTextColor="@color/nav_item_color"
            app:menu="@menu/lists_navigation" />

        <View
            android:id="@+id/nav_indicator"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/nav_indicator" />
    </FrameLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/nav_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/lists_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:longClickable="true" />


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/lists_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/lists_add"
            app:layout_anchor="@id/lists_view_pager"
            app:layout_anchorGravity="bottom|right|end"
            app:srcCompat="@drawable/ic_add_black_24px" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

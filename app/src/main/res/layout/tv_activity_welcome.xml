<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV's own dedicated first-run wizard, reached only from TvHomeActivity when the
    ad-block method is still undefined. Two screens where mobile's WelcomeActivity has four: the
    method choice is skipped outright (TV always uses VPN, decided here rather than asked, the
    welcome screens not being remote-friendly is exactly why this exists instead of reusing them),
    and so is the battery/OEM-battery guidance, which is phone-OS/phone-brand specific and
    irrelevant to a TV box; TV has its own separate, always-reachable persistence guidance on the
    home screen instead of forcing it into first run.

    Same red brand background and pill button style mobile's own welcome screens already use
    (Theme.AdAway.NoActionBar.Red / Widget.AdAway.Button.OnRed in styles.xml, both pre-existing,
    unmodified), full-bleed and vertically centered rather than the header-band layout every other
    TV screen in this app uses: this is a one-time, single-purpose moment, not a screen the user
    returns to, so it earns its own look instead of matching the everyday chrome.

    Two top-level pages (tv_welcome_intro_page / tv_welcome_activate_page), only one visible at a
    time, toggled from TvWelcomeActivity; no ViewPager2, since the mobile wizard already disables
    swipe (setUserInputEnabled(false)) and is entirely button-driven, so a D-pad loses nothing
    plain visibility toggling doesn't already give it. Within the activate page, four further
    sub-states (prompt / progress / success / error) are siblings toggled the same way, mirroring
    WelcomeSyncFragment's own inline state machine rather than a dialog, since this screen already
    owns the whole window.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcomeBackground">

    <!-- ===================== PAGE 1: INTRO ===================== -->
    <LinearLayout
        android:id="@+id/tv_welcome_intro_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_logo"
            app:srcCompat="@mipmap/icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/about_app_name"
            android:textAppearance="?attr/textAppearanceHeadline4"
            android:textColor="?attr/colorOnPrimary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/app_description"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textColor="?attr/colorOnPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0.85"
            android:gravity="center"
            android:maxWidth="720dp"
            android:text="@string/tv_welcome_intro_subtitle"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="?attr/colorOnPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_welcome_start_button"
            style="@style/Widget.AdAway.Button.OnRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="6dp"
            android:text="@string/tv_welcome_start_button"
            android:textSize="16sp"
            android:focusable="true"
            android:focusedByDefault="true"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <!-- ===================== PAGE 2: ACTIVATE ===================== -->
    <LinearLayout
        android:id="@+id/tv_welcome_activate_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Sub-state: prompt (default) -->
        <LinearLayout
            android:id="@+id/tv_welcome_prompt_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_vpn_key_24dp"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/tv_welcome_activate_header"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.85"
                android:gravity="center"
                android:maxWidth="720dp"
                android:text="@string/tv_welcome_activate_body"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textColor="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_welcome_activate_button"
                style="@style/Widget.AdAway.Button.OnRed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingHorizontal="32dp"
                android:paddingVertical="6dp"
                android:text="@string/button_enable_hosts"
                android:textSize="16sp"
                android:focusable="true"
                android:focusedByDefault="true"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_tv_power_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />
        </LinearLayout>

        <!-- Sub-state: progress -->
        <LinearLayout
            android:id="@+id/tv_welcome_progress_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="?attr/colorOnPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/welcome_sync_header"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_welcome_progress_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.85"
                android:gravity="center"
                android:maxWidth="720dp"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textColor="?attr/colorOnPrimary"
                tools:text="@string/welcome_sync_summary" />
        </LinearLayout>

        <!-- Sub-state: success -->
        <LinearLayout
            android:id="@+id/tv_welcome_success_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/welcome_button_background"
                android:contentDescription="@null"
                android:padding="16dp"
                app:srcCompat="@drawable/baseline_check_24"
                app:tint="@color/welcomeBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/welcome_synced_header"
                android:textAppearance="?attr/textAppearanceHeadline5"
                android:textColor="?attr/colorOnPrimary"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_welcome_finish_button"
                style="@style/Widget.AdAway.Button.OnRed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingHorizontal="32dp"
                android:paddingVertical="6dp"
                android:text="@string/welcome_finish_button"
                android:textSize="16sp"
                android:focusable="true"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <!-- Sub-state: error -->
        <LinearLayout
            android:id="@+id/tv_welcome_error_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                app:srcCompat="@android:drawable/ic_dialog_alert"
                app:tint="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tv_welcome_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:maxWidth="720dp"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textColor="?attr/colorOnPrimary"
                tools:text="@string/welcome_sync_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_welcome_retry_button"
                style="@style/Widget.AdAway.Button.OnRed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="32dp"
                android:paddingVertical="6dp"
                android:text="@string/welcome_sync_retry_logo"
                android:textSize="16sp"
                android:focusable="true"
                app:cornerRadius="24dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>

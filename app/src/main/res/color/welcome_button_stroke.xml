<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget.AdAway.Button.OnRed's TV D-pad focus signal: transparent normally, so the ring is
    invisible; @color/welcomeFocusRing while focused, so a ring appears around the pill.
    MaterialButton draws a stroke along the exact same shape path (corner radius included) it
    already uses for the fill, rather than as a separately-masked overlay/transform/system
    layer - a ripple wash, an elevation shadow, a scale animator and the system's own default
    focus highlight were each in turn seen cutting off at the pill's rounded ends instead of
    following them, before this confirmed working on device.

    Amber, not the button's own red text color: that blended into the same-toned red page
    behind the button, leaving the ring visible only along its inner edge against the white
    fill rather than reading as a ring at all.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="@color/welcomeFocusRing"
        android:state_focused="true" />
    <item android:color="@android:color/transparent" />
</selector>

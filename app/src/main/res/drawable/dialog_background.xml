<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded background for the preference dialogs (e.g. the dark-theme picker).
    Used as android:windowBackground in @style/ThemeOverlay.AdAway.Dialog so the
    dialog gets modern 28dp rounded corners on every API level.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="@color/dialogSurface" />
</shape>
